pragma language_version >= 0.16 && <= 0.23;

import CompactStandardLibrary;

// On-chain record: hash -> commitment, hash -> timestamp, plus a monotonic
// round counter that anchors submission order. No Unix-time API is exposed
// by the documented ADTs, so `timestamp` is caller-provided (Uint<64>) and
// `round` gives the consensus-ordered sequence number.

export ledger commitmentByHash: Map<Bytes<32>, Bytes<32>>;
export ledger timestampByHash: Map<Bytes<32>, Uint<64>>;
export ledger round: Counter;

constructor() {}

export circuit submitProof(hash: Bytes<32>, commitment: Bytes<32>, timestamp: Uint<64>): [] {
  assert(!commitmentByHash.member(disclose(hash)), "A proof for this hash already exists");
  commitmentByHash.insert(disclose(hash), disclose(commitment));
  timestampByHash.insert(disclose(hash), disclose(timestamp));
  round.increment(1);
}

export circuit verifyProof(hash: Bytes<32>): Boolean {
  return commitmentByHash.member(disclose(hash));
}